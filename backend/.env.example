# Copy to .env and fill in values. Never commit .env.

# Required
MONGO_URL=mongodb://127.0.0.1:27017/your-db-name
JWT_SECRET=use-a-long-random-string-at-least-8-chars

# CORS: one origin, or comma-separated list (first is used for email links)
FRONTEND_URL=http://localhost:5173

# Public backend URL (used for avatar upload links in production)
BACKEND_URL=http://localhost:8000

PORT=5000

# Redis (BullMQ email queue). Prefer REDIS_URL for managed hosts (e.g. Upstash).
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Arcjet (https://app.arcjet.com)
ARCJET_KEY=

# Brevo SMTP (https://www.brevo.com)
BREVO_USER=
BREVO_PASS=
BREVO_SENDER_NAME=TaskPilot
BREVO_SENDER_EMAIL=noreply@yourdomain.com
